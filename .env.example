# Aranet Cloud
ARANET_API_BASE_URL=https://aranet.cloud
ARANET_API_KEY=replace_with_a_rotated_key
ARANET_HTTP_TIMEOUT_SECONDS=30
ARANET_HTTP_RETRIES=5
ARANET_PAGE_LIMIT=10000
ARANET_SENSOR_BATCH_SIZE=10

# PostgreSQL target database
PGHOST=localhost
PGPORT=5432
PGDATABASE=agro_platform
PGUSER=postgres
PGPASSWORD=replace_me
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10
PGADMIN_DATABASE=postgres

# Synchronization
# Leave blank to infer the first backfill date from base registration/pairing data.
ARANET_BACKFILL_FROM=
ARANET_BACKFILL_WINDOW_DAYS=30
ARANET_INCREMENTAL_OVERLAP_MINUTES=30
ARANET_INITIAL_LOOKBACK_HOURS=24
ARANET_CATALOG_REFRESH_HOURS=6
ARANET_RECONCILIATION_LOOKBACK_DAYS=7
ARANET_RECONCILIATION_INTERVAL_HOURS=24

# Runtime
LOG_LEVEL=INFO
LOG_DIR=logs
